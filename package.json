{
  "name": "classifizer",
  "version": "1.2.0",
  "description": "CSS classes builder & CSS-modules stylizer",
  "main": "build/main/index.js",
  "module": "build/module/index.js",
  "types": "build/main/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/main/index.d.ts",
      "import": "./build/module/index.js",
      "require": "./build/main/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "build/main",
    "build/module"
  ],
  "author": "Novosad Konstantin <konstantus@live.ru>",
  "repository": "https://github.com/sam0sva1/classifizer",
  "license": "MIT",
  "keywords": [
    "classnames",
    "classes",
    "bem",
    "css-modules",
    "css",
    "classbuilder"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:main && npm run build:module",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "clean": "rm -rf build",
    "fix": "prettier \"src/**/*.ts\" --write && eslint src/ --fix",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  },
  "prettier": {
    "singleQuote": true
  }
}
